# ===================================
# FoodGuard .gitignore
# ===================================

# =========================
# DATASETS (large, do NOT commit)
# =========================
food_101/
food_image_dataset/
indian_food_data/
ai_generated/
dataset_4class/

# =========================
# MODEL CHECKPOINTS & WEIGHTS
# =========================
checkpoints/*
!checkpoints/food_detector/
checkpoints/food_detector/*
!checkpoints/food_detector/food_ai_detector.pth
!checkpoints/food_detector/metadata.json
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5

# =========================
# GENERATED / INTERMEDIATE FILES
# =========================
generation_metadata.json
generation_checkpoint.json
dataset_index.csv
dataset_index_new.csv

# =========================
# PYTHON CACHE
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
*.so

# =========================
# VIRTUAL ENVIRONMENTS
# =========================
venv/
.venv/
env/
.conda/

# =========================
# ENV / SECRETS
# =========================
.env
.env.*

# =========================
# JUPYTER NOTEBOOKS
# =========================
.ipynb_checkpoints/
*.ipynb

# =========================
# IDE & EDITOR FILES
# =========================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# =========================
# OS FILES
# =========================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# =========================
# LOGS & TEMP
# =========================
*.log
*.tmp
*.bak
*.swp
qt_result.txt
quick_test_output.txt

# =========================
# ARCHIVES (large dataset zips)
# =========================
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# =========================
# UNNECESSARY / DEBUG FILES
# =========================
check_counts.py
fix_script.py
datasets_used.txt
README_4CLASS_TRAINING.md
FoodGuard_Project_Report.txt
scripts/test_realvisxl.py
config/default.yaml
0.9.0
*.pptx
*.docx
